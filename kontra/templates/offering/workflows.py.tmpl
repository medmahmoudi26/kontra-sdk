"""Temporal through the kontra façade (D1): `workflow` and `RetryPolicy` are Temporal's own
objects, so with `from temporalio import ...` this runs on any Temporal. Kontra starts it
with the id `job-<job id>` when a buyer hires the offering; any Temporal feature works
inside (child workflows, signals, local activities), and
`workflow.execute_activities_in_parallel` runs one activity per item without your code ever
continuing as new."""

from datetime import timedelta

from kontra import RetryPolicy, workflow

with workflow.unsafe.imports_passed_through():
    from activities import count_words
    from models import {{Class}}Input, {{Class}}Output


@workflow.defn
class {{Class}}Flow:
    @workflow.run
    async def run(self, inp: {{Class}}Input) -> {{Class}}Output:
        return await workflow.execute_activity(
            count_words,
            inp.text,
            start_to_close_timeout=timedelta(minutes=5),
            heartbeat_timeout=timedelta(minutes=1),
            retry_policy=RetryPolicy(maximum_attempts=3),
        )
