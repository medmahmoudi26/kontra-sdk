# The offering's one dependency is kontra-sdk, which brings the Temporal SDK (temporalio) in
# the range kontra-sdk is tested on; workflows.py and activities.py import temporalio
# directly, and worker.py is the one file that imports kontra (decisions I29). Not a package:
# `pip install .` installs the dependency and nothing else; `kontra serve` runs the modules
# from this directory.
#
# The tests need no containers:
#
#   pip install "kontra-sdk[testing]" pytest
#   pytest
[project]
name = "{{name}}"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = ["kontra-sdk"]

[tool.setuptools]
py-modules = []

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]
